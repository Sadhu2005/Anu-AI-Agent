[Unit]
Description=ANU Autonomous Development Agent Runtime
After=local-fs.target anu-sandbox.service
Wants=anu-sandbox.service
Requires=anu-agent.slice
ConditionPathExists=/srv/anu/config/anu-policy.yaml
ConditionPathExists=/srv/anu/bin/anu-runtime.py

[Service]
Type=simple

User=anu-agent
Group=anu-agent

WorkingDirectory=/srv/anu/home

ExecStart=/usr/bin/python3 /srv/anu/bin/anu-runtime.py

Restart=on-failure
RestartSec=10

# SIGTERM reaches only the runtime, which finishes the cycle in flight;
# a Safe Mutation child must not be killed mid-transaction. The stop
# timeout must exceed the Task Engine's 300 s Safe Mutation timeout.
KillMode=mixed
TimeoutStopSec=420

Slice=anu-agent.slice

UMask=0077

# Privilege protection
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem protection
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# Kernel/system protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# No network for the current ANU runtime.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX

# ANU needs to read its code/config but only write inside its
# designated runtime directories.
ReadOnlyPaths=/srv/anu/config
ReadOnlyPaths=/srv/anu/bin
ReadOnlyPaths=/srv/anu/src
# V0.6.9 G1/G2: secrets and tests are not writable by the agent.
ReadOnlyPaths=/srv/anu/secrets
ReadOnlyPaths=/srv/anu/tests

ReadWritePaths=/srv/anu/home
ReadWritePaths=/srv/anu/brain
ReadWritePaths=/srv/anu/workspace
ReadWritePaths=/srv/anu/sandbox
ReadWritePaths=/srv/anu/browser
ReadWritePaths=/srv/anu/logs
ReadWritePaths=/srv/anu/runtime

# Make ANU disposable under system memory pressure.
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
