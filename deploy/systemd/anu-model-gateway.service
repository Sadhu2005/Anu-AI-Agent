# ANU Model Gateway (V0.7.1 step 2)
# anu-agent stays PrivateNetwork; only this service reaches LM Studio / cloud.
#
# Install (Pi, as root):
#   1. Create user: useradd --system --home /nonexistent --shell /usr/sbin/nologin anu-model
#      usermod -aG anu-agent anu-model   # optional shared group for socket dir
#   2. Install key (never in git):
#        install -d -m 0750 /etc/anu
#        printf '%s' 'YOUR_LM_STUDIO_TOKEN' > /etc/anu/model-api-key
#        chown root:anu-model /etc/anu/model-api-key && chmod 0640 /etc/anu/model-api-key
#   3. Set config base_url to PC LAN, e.g. http://192.168.1.13:1234/v1
#   4. cp deploy/systemd/anu-model-gateway.service /etc/systemd/system/
#      systemctl daemon-reload && systemctl enable --now anu-model-gateway

[Unit]
Description=ANU Model Gateway (OpenAI-compatible)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/anu/config/anu-model-gateway.yaml
ConditionPathExists=/srv/anu/bin/anu-model-gateway-v0.1.py

[Service]
Type=simple
User=anu-model
Group=anu-agent

# Do not use /srv/anu/home — it may be missing or unreadable by anu-model (CHDIR 200).
WorkingDirectory=/srv/anu
Environment=ANU_BASE=/srv/anu

# API key via systemd credential → file env (never commit keys).
LoadCredential=model_api_key:/etc/anu/model-api-key
Environment=ANU_MODEL_API_KEY_FILE=%d/model_api_key

RuntimeDirectory=anu-model
RuntimeDirectoryMode=0750
UMask=0007

ExecStart=/usr/bin/python3 /srv/anu/bin/anu-model-gateway-v0.1.py serve

Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Outbound HTTP to LM Studio (LAN) or cloud — not PrivateNetwork.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

ReadOnlyPaths=/srv/anu/config
ReadOnlyPaths=/srv/anu/bin
ReadWritePaths=/srv/anu/logs

[Install]
WantedBy=multi-user.target
